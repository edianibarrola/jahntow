# This file includes global variables that will be available inside your project
# 1. In the front end code you can access this variables like this: console.log(process.env.VARIABLE_NAME)
# 1. In the back end code you access the variable by importing os and then typing print(os.getenv('VARIABLE_NAME'))

# Back-End Variables
DATABASE_URL=postgres://gitpod:postgres@localhost:5432/example
FLASK_APP=src/app.py

# development enables the sitemap page, verbose errors, and relaxes CORS to allow any origin.
# Use "production" everywhere else.
FLASK_ENV=development

# The backend also reads these (not needed for local dev - only add them to
# your real .env if you're running the backend against a production
# database, since the app refuses to start without them outside of
# FLASK_ENV=development). Deliberately NOT listed as KEY= lines below:
# dotenv-webpack's "safe" mode would otherwise require every one of them to
# be non-empty just to build the frontend, even though the frontend never
# reads any of them.
#
#   FLASK_APP_KEY   - required in production. Generate with:
#                     python -c "import secrets; print(secrets.token_hex(32))"
#   JWT_SECRET_KEY  - required in production, generate the same way
#   CORS_ORIGINS    - comma-separated allowed frontend origins in production,
#                     e.g. https://your-app.example.com
#   ADMIN_USERNAME  - optional: set together with ADMIN_PASSWORD to enable
#   ADMIN_PASSWORD    the /admin panel (HTTP Basic Auth). Leave both unset
#                     to keep it fully disabled.

# Front-End Variables
BASENAME=/
#BACKEND_URL=
