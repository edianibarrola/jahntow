# Copy this file to .env and fill in what you need.
# See README.md for what each variable does.

# --- Backend ---
DATABASE_URL=
FLASK_APP=src/app.py
FLASK_ENV=development

# Required in production only. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_APP_KEY=
JWT_SECRET_KEY=

# Optional, production only.
CORS_ORIGINS=

# Optional: set both to enable the /admin panel (HTTP Basic Auth).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Frontend ---
BASENAME=/
BACKEND_URL=http://localhost:3001
